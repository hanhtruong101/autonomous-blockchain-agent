# LOCAL DEVELOPMENT ONLY. No private key is needed: Anvil provides disposable unlocked accounts.
# Set this in your shell before docker compose up --build. Never use an account with real assets.
AUTONOMY_OWNER_TOKEN=replace-with-a-random-local-token-at-least-24-characters
AUTONOMY_ENVIRONMENT=local
AUTONOMY_CHAIN_ID=31337
AUTONOMY_RPC_URL=http://127.0.0.1:8545
AUTONOMY_DATABASE_URL=postgresql+psycopg://autonomy:local-only@localhost:5432/autonomy
AUTONOMY_DEPLOYMENT_PATH=local/deployment.json

# Optional OpenAI mode. Offline makes no paid requests and requires no key.
OPENAI_API_KEY=your_openai_api_key_here
AUTONOMY_AI_PROVIDER=offline
AUTONOMY_AI_MODEL=gpt-6-luna

# Local Ollama alternative (native backend; no key needed):
# AUTONOMY_AI_PROVIDER=ollama
# AUTONOMY_AI_MODEL=llama3:latest

# Worker available by default; trading schedules stay OFF until explicitly enabled in UI.
AUTONOMY_AUTOMATION_WORKER=true
